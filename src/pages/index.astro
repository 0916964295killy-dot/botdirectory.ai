---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PrimaryButton from '../components/PrimaryButton.astro';
import SponsorCard from '../components/SponsorCard.astro';
import TagDialog from '../components/TagDialog.astro';
import MarqueeStrips from '../components/MarqueeStrips.astro';
import EdgeColumn from '../components/EdgeColumn.astro';
import SponsorShuffle from '../components/SponsorShuffle.astro';
import ToolIcon from '../components/ToolIcon.astro';
import Select from '../components/Select.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { FEATURES, SITE, SPONSORING } from '../config';
import { CATEGORIES, CATEGORY_LABEL, catStyle, familyStyle, fmt } from '../lib/constants';
import { botListingText, getBots, SPONSORS, PROMOS, type Bot, type Promo } from '../lib/data';
import { categorySlug, listIntegrations, MIN_INTEGRATION_HUB_BOTS, organizationStructuredData } from '../lib/seo';
import { sponsorUrl } from '../lib/utm';
import { promptExcerpt } from '../lib/text';

const bots = [...(await getBots())].sort(
  (a, b) => b.copies - a.copies || a.name.localeCompare(b.name),
);
const integrations = listIntegrations(bots, 1);
const allTools = integrations.map(({ name }) => name).sort();
const topIntegrationHubs = integrations.filter(({ count }) => count >= MIN_INTEGRATION_HUB_BOTS).slice(0, 8);

const mode = SPONSORING.mode;
const hasRail = mode === 'rail' || mode === 'both';
const hasEdge = mode === 'both';
const pageCols = hasEdge ? '252px minmax(0, 1fr) 252px' : 'minmax(0, 1fr)';
const browseMax = mode === 'rail' ? '1460px' : '1150px';
const browseGrid = mode === 'rail' ? 'minmax(0, 1fr) 272px' : 'minmax(0, 1fr)';
const sponsorsRight = mode === 'both' ? SPONSORS : SPONSORS.slice(0, 3);
const slotsLine =
  mode === 'both'
    ? `${SPONSORING.slotsTakenBoth} of ${SPONSORING.slotsTotalBoth} spots taken`
    : `${SPONSORING.slotsTaken} of ${SPONSORING.slotsTotal} spots taken`;
const railWrapClass = mode === 'both' ? 'iz-only-narrow' : '';

// In-list sponsor mode: promoted rows spliced at fixed indexes.
type Row = { bot: Bot; promo?: undefined } | { promo: Promo; bot?: undefined };
const rows: Row[] = bots.map((b) => ({ bot: b }));
if (mode === 'inline') {
  // High indexes first so each `at` stays a position in the bot list.
  for (const p of [...PROMOS].sort((a, b) => b.at - a.at)) {
    rows.splice(Math.min(p.at, rows.length), 0, { promo: p });
  }
}

const searchText = (b: Bot) => [b.name, b.category, CATEGORY_LABEL[b.category], ...b.integrations, b.contributor].filter(Boolean).join(' ').toLowerCase();

const title = `Grok Bot Prompts & AI Bot Directory | ${SITE.wordmark}`;
const description =
  'Browse ready-to-use bot prompts for Grok Bot, Rakazo, and other AI agents. Copy a workflow, connect its tools, and launch a scheduled bot in minutes.';
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    name: SITE.wordmark,
    url: SITE.url,
    description,
    publisher: organizationStructuredData(),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${SITE.url}/#directory`,
    name: 'AI bot prompt directory',
    url: SITE.url,
    description,
    isPartOf: { '@id': `${SITE.url}/#website` },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: bots.length,
      itemListElement: bots.map((bot, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: bot.name,
        url: `${SITE.url}/bots/${bot.slug}/`,
      })),
    },
  },
];
---

<Base title={title} description={description} structuredData={structuredData}>
  <div class:list={['iz-page-root', { 'hide-copies': !FEATURES.showCopies }]}>
    {mode !== 'inline' && <MarqueeStrips />}

    <div class="iz-cols" style={`grid-template-columns: ${pageCols};`}>
      {hasEdge && <EdgeColumn side="left" />}

      <div style="min-width: 0;">
        <Header isHome />

        <section class="hero">
          <p class="iz-eyebrow">
            支援 <a href={SITE.grokBotUrl}>Grok Bot</a> 與 <a href={SITE.rakazoUrl}>Rakazo</a>
          </p>
          <h1 class="hero-title">AI 機器人目錄</h1>
          <p class="hero-sub">精選 AI 助理與實用提示詞，協助你處理工作、學習、創作與日常生活。</p>
        </section>

        <NewsletterSignup />

        <section id="browse" class="browse" style={`max-width: ${browseMax};`}>
          <div class="iz-browse-grid" style={`grid-template-columns: ${browseGrid};`}>
            <div style="min-width: 0;">
              <div class="filterbar">
                <div class="filterbar-controls">
                  <input type="text" id="bot-search" class="search-input" placeholder="搜尋 AI 機器人" />
                  <Select
                    id="bot-category"
                    label="依分類篩選"
                    options={[{ value: 'All', label: '所有分類' }, ...CATEGORIES.map((c) => ({ value: c, label: CATEGORY_LABEL[c], swatch: catStyle(c).catFg }))]}
                  />
                  <Select
                    id="bot-integration"
                    label="依工具篩選"
                    options={[{ value: 'all', label: '所有工具' }, ...allTools.map((t) => ({ value: t, label: t, tool: t }))]}
                  />
                  <Select
                    id="bot-sort"
                    label="排序方式"
                    value="copies"
                    options={[
                      ...(FEATURES.showCopies ? [{ value: 'copies', label: '最多複製' }] : []),
                      { value: 'newest', label: '最新加入' },
                      { value: 'name', label: '名稱排序' },
                    ]}
                  />
                  <div class="view-toggle">
                    <button type="button" id="view-table-btn" class="view-btn active">表格</button>
                    <button type="button" id="view-cards-btn" class="view-btn">卡片</button>
                  </div>
                </div>
              </div>

              <div id="directory-view" class="bot-table directory-view" data-view="table">
                <div class="bot-table-head">
                  <span>AI 機器人</span><span>分類</span><span>支援工具</span>{FEATURES.showCopies && <span>Copies</span>}<span>提供者</span><span class="bot-table-add-head">Add</span>
                </div>
                {
                  rows.map((row) =>
                    row.bot ? (
                      <div
                        class="bot-row"
                        data-slug={row.bot.slug}
                        data-name={row.bot.name}
                        data-category={row.bot.category}
                        data-copies={row.bot.copies}
                        data-added-at={row.bot.addedAt}
                        data-integrations={row.bot.integrations.join('|')}
                        data-search={searchText(row.bot)}
                      >
                        <span class="bot-row-namecell">
                          <span class="bot-row-nameline">
                            <a href={`/bots/${row.bot.slug}/`} class="bot-row-name">{row.bot.name}</a>
                          </span>
                          <span class="directory-card-summary" data-prompt-slug={row.bot.slug}>
                            {promptExcerpt(botListingText(row.bot))}
                          </span>
                        </span>
                        <span
                          class="cat-pill"
                          style={`color: ${catStyle(row.bot.category).catFg}; background: ${catStyle(row.bot.category).catBg}; border-color: ${catStyle(row.bot.category).catBorder};`}
                         >{CATEGORY_LABEL[row.bot.category]}</span>
                        <span class="bot-row-tools">
                          {row.bot.integrations.map((t) => (
                            <span class="bot-row-tool"><ToolIcon name={t} size={14} />{t}</span>
                          ))}
                        </span>
                        {FEATURES.showCopies && (
                          <span class="bot-row-copies" data-copies-slug={row.bot.slug} data-copies-seed={row.bot.copies}>{fmt(row.bot.copies)} copies</span>
                        )}
                        <span class="bot-row-contrib">{row.bot.contributor ? `@${row.bot.contributor}` : '—'}</span>
                        <span class="bot-row-action">
                          {
                            row.bot.grokShareUrl && (
                              <a
                                href={row.bot.grokShareUrl}
                                class="add-grok-btn bot-row-add"
                                target="_blank"
                                rel="noopener noreferrer"
                                data-grok-share
                              >
                                Add
                              </a>
                            )
                          }
                        </span>
                      </div>
                    ) : (
                      <a
                        href={sponsorUrl(row.promo.href, 'promo')}
                        class="bot-row promo-row"
                        data-promo
                        data-sponsor={row.promo.name}
                        data-sponsor-placement="promo"
                        data-at={row.promo.at}
                        rel="sponsored"
                        style={`background: var(--iz-${row.promo.family}-50);`}
                      >
                        <span class="bot-row-namecell">
                          <span class="bot-row-nameline">
                            {
                              row.promo.logo && (
                                <img class="promo-logo logo-img" src={row.promo.logo} alt="" width="28" height="28" />
                              )
                            }
                            <span class="bot-row-name">{row.promo.name}</span>
                            <span class="promo-tag-row">Sponsored</span>
                          </span>
                          <span class="bot-row-note">{row.promo.note}</span>
                        </span>
                        <span
                          class="cat-pill"
                          style={`color: ${familyStyle(row.promo.family).fg}; background: ${familyStyle(row.promo.family).bg}; border-color: ${familyStyle(row.promo.family).border};`}
                        >{row.promo.category}</span>
                        <span class="bot-row-tools">
                          {row.promo.integrations.map((t) => (
                            <span class="bot-row-tool"><ToolIcon name={t} size={14} />{t}</span>
                          ))}
                        </span>
                        {FEATURES.showCopies && <span class="bot-row-copies">Sponsored</span>}
                        <span class="bot-row-contrib">{row.promo.source ?? `@${row.promo.contributor}`}</span>
                        <span class="bot-row-action"><span class="add-grok-btn bot-row-add">Visit</span></span>
                      </a>
                    )
                  )
                }
              </div>

              <div id="empty-state" class="empty-state" hidden>
                <p class="empty-state-title">目前沒有符合條件的機器人。</p>
                <p class="empty-state-sub">歡迎提交新的 AI 機器人，持續豐富目錄內容。</p>
              </div>
            </div>

            {
              hasRail && (
                <div class:list={['iz-rail-wrap', railWrapClass]}>
                  <div class="rail-head">
                    <span class="rail-label">Sponsored</span>
                    <a href="/sponsor/" class="rail-slots">{slotsLine}</a>
                  </div>
                  <aside class="iz-rail">
                    {sponsorsRight.map((s) => <SponsorCard sponsor={s} />)}
                    <a href="/sponsor/" class="slot-empty">
                      <span class="slot-empty-title">Your tool here</span>
                      <span class="slot-empty-pitch">{SPONSORING.railPitch}</span>
                    </a>
                  </aside>
                </div>
              )
            }
          </div>
        </section>
      </div>

      {hasEdge && <EdgeColumn side="right" />}
    </div>

    <section id="contribute" class="contribute-section">
      <div class="contribute-inner">
        <div>
          <p class="iz-eyebrow">參與貢獻</p>
          <h2 class="contribute-title">新增機器人，只需一個檔案</h2>
          <p class="contribute-copy">
            只要新增一個 Markdown 檔案，寫入提示詞與所需工具，再提交
            Pull Request，就能讓機器人出現在目錄中。
            
            
          </p>
          <div class="cta-row">
            <PrimaryButton href={SITE.repoUrl}>提交機器人</PrimaryButton>
            <button type="button" class="btn-secondary" data-tag-open>標記 X 貼文</button>
          </div>
          <a href={SITE.contributingUrl} class="contribute-guide-link">閱讀貢獻指南 →</a>
          <p class="contribute-alt">
            No PR needed: tag <a href={SITE.xUrl}>{SITE.xHandle}</a> under any tweet about a bot setup and our
            agent does the rest.
          </p>
          <p class="contribute-alt">
            Building a bot that watches the directory? <a href="https://api.botdirectory.ai/api/bots">Use the public JSON API</a>
            — search, filter, and page through every listing. Submissions accept optional <code>grokShareUrl</code>.
          </p>
        </div>
        <div class="file-card">
          <div class="file-card-head">
            <span class="file-card-name">bots/seo-improver.md</span>
          </div>
          <pre class="file-card-body">---
name: SEO Improver
category: Marketing
added_at: "2026-08-18T12:00:00.000Z"
contributor: elie2222
integrations: [GitHub, DataForSEO, Search Console]
grok_share_url: https://x.ai/bot/Y7LbP6p5EBFjfdTp69cKr
---

You improve my SEO on a schedule. Walk me
through connecting GitHub, DataForSEO and
Google Search Console, then every 2 weeks:
find pages losing impressions or sitting on
page two, rewrite titles and metadata, fix
internal links, and open a PR I review
before merge.</pre>
        </div>
      </div>
    </section>

    <section id="sponsor" class="sponsor-section">
      <div class="sponsor-inner">
        <div>
          <p class="sponsor-eyebrow">Sponsor</p>
          <h2 class="sponsor-title">Get your tool in the room</h2>
          <p class="sponsor-copy">
            This is where people decide what to build with. <a href="/sponsor/" class="sponsor-more">See placements and pricing →</a>
          </p>
        </div>
        <PrimaryButton href="/sponsor/">Sponsor</PrimaryButton>
      </div>
    </section>

    <section class="discovery-section">
      <div class="discovery-inner">
        <nav class="discovery-links" aria-label="Browse prompt collections">
          <span>探索分類：</span>
          {CATEGORIES.map((category) => <a href={`/categories/${categorySlug(category)}/`}>{CATEGORY_LABEL[category]}</a>)}
          <a href="/integrations/">依工具</a>
          <a href="/collections/chief-of-staff/">幕僚長助理提示詞</a>
        </nav>
        <nav class="discovery-links discovery-links-tools" aria-label="Popular integrations">
          <span>熱門工具：</span>
          {topIntegrationHubs.map((integration) => <a href={`/integrations/${integration.slug}/`}>{integration.name}</a>)}
        </nav>
      </div>
    </section>

    <Footer />
    <TagDialog />
  </div>

  <SponsorShuffle />
</Base>

<script>
  import '../scripts/browse';
</script>
